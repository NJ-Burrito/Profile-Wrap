{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/nj-linkedin/doctor.schema.json",
  "title": "njli doctor --json output",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "plugin_version": {
      "type": "string"
    },
    "os": {
      "enum": [
        "windows",
        "macos",
        "linux"
      ]
    },
    "python": {
      "type": "string"
    },
    "workspace": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string"
        }
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "object",
      "properties": {
        "pass": {
          "type": "integer",
          "minimum": 0
        },
        "warn": {
          "type": "integer",
          "minimum": 0
        },
        "fail": {
          "type": "integer",
          "minimum": 0
        },
        "skip": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "pass",
        "warn",
        "fail",
        "skip"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pass",
              "warn",
              "fail",
              "skip"
            ]
          },
          "detail": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "status",
          "detail",
          "hint"
        ]
      },
      "minItems": 1
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plugin_version",
    "os",
    "python",
    "workspace",
    "generated_at",
    "summary",
    "checks"
  ]
}
