{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/profile-wrap/targets.schema.json",
  "title": "People to engage with (engage/targets.json)",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "profile_url": {
            "type": "string",
            "pattern": "^https://www\\.linkedin\\.com/"
          },
          "why": {
            "type": "string"
          },
          "lang": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$"
          },
          "region": {
            "type": "string"
          },
          "tag": {
            "type": "string"
          },
          "verified": {
            "type": "boolean"
          },
          "last_post_at": {
            "type": "string",
            "format": "date-time"
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          },
          "fictional": {
            "type": "boolean"
          }
        },
        "additionalProperties": true,
        "required": [
          "name",
          "profile_url"
        ]
      }
    }
  },
  "additionalProperties": true,
  "required": [
    "schema_version",
    "targets"
  ]
}
