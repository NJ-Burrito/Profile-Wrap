              ]
            },
            "apify": {
              "type": "object",
              "properties": {
                "token_env": {
                  "type": "string"
                },
                "max_calls_per_day": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false,
              "required": [
                "token_env",
                "max_calls_per_day"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "provider",
            "apify_ack",
            "apify"
          ]
        },
        "connect": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "weekly_slots": {
              "type": "integer",
              "minimum": 0,
              "x-ceiling": 5
            },
            "min_score": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "note_max": {
              "type": "integer",
              "minimum": 1,
              "x-ceiling": 200
            },
            "pass_days": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "enabled",
            "weekly_slots",
            "min_score",
            "note_max",
            "pass_days"
          ]
        },
        "targets_file": {
          "type": "string"
        },
        "max_post_age_hours": {
          "type": "integer",
          "minimum": 1
        },
        "inactive_days": {
          "type": "integer",
          "minimum": 1
        },
        "quota": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "extras_waiting": {
          "type": "integer",
          "minimum": 0
        },
        "retention_days": {
          "type": "object",
          "properties": {
            "engage": {
              "type": "integer",
              "minimum": 1
            },
            "connect": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "engage",
            "connect"
          ]
        },
        "strip_tracking_params": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "comments",
        "replies",
        "reading",
        "connect",
        "targets_file",
        "max_post_age_hours",
        "inactive_days",
        "quota",
        "extras_waiting",
        "retention_days",
        "strip_tracking_params"
      ]
    },
    "research": {
