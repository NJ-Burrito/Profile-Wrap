{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/nj-linkedin/manifest.schema.json",
  "title": "Workspace template manifest (templates/manifest.json)",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "template_version": {
      "type": "string",
      "minLength": 1
    },
    "dirs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "gitkeep": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dest": {
            "type": "string",
            "minLength": 1
          },
          "src": {
            "type": "string",
            "minLength": 1
          },
          "class": {
            "enum": [
              "managed",
              "seeded"
            ]
          },
          "render": {
            "enum": [
              "none",
              "vars"
            ]
          },
          "block": {
            "type": "string"
          },
          "from": {
            "enum": [
              "templates",
              "plugin"
            ]
          },
          "optional": {
            "type": "boolean"
          },
          "once": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "required": [
          "dest",
          "src",
          "class"
        ]
      }
    },
    "user_globs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "template_version",
    "files",
    "user_globs"
  ]
}
