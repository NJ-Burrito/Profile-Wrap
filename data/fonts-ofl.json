{
  "schema_version": 1,
  "note": "OFL fonts that 'profile-wrap fonts fetch' can install from fontsource npm packages into brand/fonts/ (git-ignored, never committed). Versions come from data/pins.json (npm) first, then 'version' here. Add a family by adding an entry; every file must be under the SIL Open Font License.",
  "families": {
    "IBM Plex Sans": {
      "package": "@fontsource/ibm-plex-sans",
      "slug": "ibm-plex-sans",
      "subset": "latin",
      "script": "latin",
      "weights": [400, 500, 700],
      "style": "normal",
      "license": "OFL-1.1",
      "license_file": "LICENSE"
    },
    "IBM Plex Sans Arabic": {
      "package": "@fontsource/ibm-plex-sans-arabic",
      "slug": "ibm-plex-sans-arabic",
      "subset": "arabic",
      "script": "arabic",
      "weights": [400, 500, 700],
      "style": "normal",
      "license": "OFL-1.1",
      "license_file": "LICENSE"
    }
  },
  "defaults": {
    "display": "IBM Plex Sans",
    "text": "IBM Plex Sans",
    "arabic": "IBM Plex Sans Arabic"
  }
}
