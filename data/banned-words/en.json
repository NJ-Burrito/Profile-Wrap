    {
      "id": "not_only_but",
      "severity": "warn",
      "message": "'not just X but Y' construction",
      "regex": "\\bnot\\s+(?:just|only|merely)\\s+[^.\\n]{1,50}?,?\\s+but\\b"
    },
    {
      "id": "staged_opener",
      "severity": "warn",
      "message": "staged opener ('here's why / here's what')",
