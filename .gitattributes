# Line endings, narrowed on purpose: no rule may match plugins/** (Anthropic's plugin directory rejects
# a repository whose .gitattributes sets the text attribute on anything its validator reads).
bin/profile-wrap text eol=lf
bin/*.cmd text eol=crlf
brand-kit/**/*.js text eol=lf
brand-kit/**/*.svg text eol=lf
gui_assets/**/*.js text eol=lf
profile_wrap/board/app/*.js text eol=lf
