{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/nj-linkedin/pending.schema.json",
  "title": "Comment and reply drafts waiting for a human (engage/pending.json)",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "urn": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "comment",
              "reply"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "lang": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "enum": [
              "pending",
              "posted",
              "skipped"
            ]
          },
          "parent": {
            "type": "string"
          },
          "gate": {
            "type": "object"
          },
          "fictional": {
            "type": "boolean"
          }
        },
        "additionalProperties": true,
        "required": [
          "text",
          "kind",
          "status"
        ]
      }
    }
  },
  "additionalProperties": true,
  "required": [
    "schema_version",
    "items"
  ]
}
