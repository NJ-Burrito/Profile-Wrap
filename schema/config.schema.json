{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/profile-wrap/config.schema.json",
  "title": "Profile-Wrap workspace config (config/profile-wrap.json)",
  "description": "Unknown keys fail. Ceilings (x-ceiling) and floors (x-floor) mirror profile_wrap/policy.py and are enforced with a message by profile_wrap/limits.py, never clamped.",
  "definitions": {
    "ack": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "format": "date-time"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "date",
        "sha256"
      ]
    },
    "job": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "every_min": {
          "type": "integer",
          "minimum": 1
        },
        "when": {
          "type": "string"
        },
        "jitter_min": {
          "type": "integer",
          "minimum": 0
        },
        "every_days": {
          "type": "integer",
          "minimum": 1
        },
        "at_login": {
          "type": "boolean"
        },
        "wake": {
          "type": "boolean"
        },
        "run_if_within_hours": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled"
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "persona",
    "locale",
    "posting",
    "linkedin",
    "engagement",
    "research",
    "gate",
    "brand",
    "render",
    "models",
    "schedule",
    "board",
    "ack"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$"
    },
    "persona": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "handle": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "niche": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        },
        "goal": {
          "enum": [
            "authority",
            "clients",
            "job_seeking",
            "hiring",
            "network"
          ]
        },
        "style_preset": {
          "enum": [
            "plain",
            "impact_copy",
            "adhd_emoji"
          ]
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "primary_language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$"
        },
        "pillars": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string"
              },
              "share": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "share"
            ]
          },
          "minItems": 1
        },
        "voice_file": {
          "type": "string"
        },
        "facts_file": {
          "type": "string"
        },
        "story_bank": {
          "type": "string"
        },
        "never_say": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "private_terms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sensitive_rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ai_disclosure": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "none",
                "footer",
                "first_comment"
              ]
            },
            "text": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "mode",
            "text"
          ]
        },
        "demo": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "handle",
        "role",
        "niche",
        "audience",
        "goal",
        "style_preset",
        "languages",
        "primary_language",
        "pillars",
        "voice_file",
        "facts_file",
        "story_bank",
        "never_say",
        "private_terms",
        "sensitive_rules",
        "ai_disclosure",
        "demo"
      ]
    },
    "locale": {
      "type": "object",
      "properties": {
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "audience_regions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "weekend_days": {
          "type": "array",
          "items": {
            "enum": [
              "mon",
              "tue",
              "wed",
              "thu",
              "fri",
              "sat",
              "sun"
            ]
          },
          "uniqueItems": true
        },
        "holidays_file": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "timezone",
        "audience_regions",
        "weekend_days",
        "holidays_file"
      ]
    },
    "posting": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "copy",
            "api_click",
            "api_scheduled"
          ]
        },
        "api_scheduled_ack": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/ack"
            }
          ]
        },
        "per_week": {
          "type": "integer",
          "minimum": 1,
          "x-ceiling": 7
        },
        "weekdays": {
          "type": "array",
          "items": {
            "enum": [
              "mon",
              "tue",
              "wed",
              "thu",
              "fri",
              "sat",
              "sun"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "window": {
          "type": "object",
          "properties": {
            "start": {
              "type": "string",
              "format": "hhmm"
            },
            "end": {
              "type": "string",
              "format": "hhmm"
            }
          },
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ]
        },
        "min_gap_hours": {
          "type": "number",
          "x-floor": 12
        },
        "missed_after_hours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "time_spread": {
          "type": "boolean"
        },
        "spread": {
          "type": "object",
          "properties": {
            "avoid_round_minutes": {
              "type": "boolean"
            },
            "no_repeat_days": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "avoid_round_minutes",
            "no_repeat_days"
          ]
        },
        "visibility": {
          "enum": [
            "PUBLIC",
            "CONNECTIONS"
          ]
        },
        "first_comment": {
          "type": "boolean"
        },
        "formats_enabled": {
          "type": "array",
          "items": {
            "enum": [
              "text",
              "slides",
              "gif",
              "image",
              "document",
              "multi_image"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "required": [
        "mode",
        "api_scheduled_ack",
        "per_week",
        "weekdays",
        "window",
        "min_gap_hours",
        "missed_after_hours",
        "time_spread",
        "spread",
        "visibility",
        "first_comment",
        "formats_enabled"
      ]
    },
    "linkedin": {
      "type": "object",
      "properties": {
        "api_version": {
          "type": "string",
          "minLength": 1
        },
        "redirect_uri": {
          "type": "string",
          "pattern": "^http://(localhost|127\\.0\\.0\\.1)(:[0-9]+)?/"
        },
        "scopes": {
          "type": "array",
          "items": {
            "enum": [
              "openid",
              "profile",
              "email",
              "w_member_social"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "token_warn_days": {
          "type": "integer",
          "minimum": 1
        },
        "sunset_warn_days": {
          "type": "integer",
          "minimum": 1
        },
        "timeout_s": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "api_version",
        "redirect_uri",
        "scopes",
        "token_warn_days",
        "sunset_warn_days",
        "timeout_s"
      ]
    },
    "engagement": {
      "type": "object",
      "properties": {
        "comments": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "draft",
                "api"
