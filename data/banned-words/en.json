  "patterns": [
    {
      "id": "contrast",
      "severity": "fail",
      "message": "'it's not X, it's Y' contrast; state the point directly",
      "regex": "\\b(?:it'?s|it is|this is|that'?s|that is|this was|it was)\\s+not\\s+(?:just\\s+|only\\s+|about\\s+)?[^.\\n]{1,60}?[.,;:]\\s*(?:it'?s|it is|but|this is|that'?s|rather)\\b"
    },
    {
      "id": "contrast_isnt",
      "severity": "fail",
      "message": "'this isn't X, it's Y' contrast; state the point directly",
      "regex": "\\b(?:it|this|that)\\s+(?:isn'?t|wasn'?t)\\s+(?:just\\s+|only\\s+|about\\s+)?[^.\\n]{1,60}?[.,;:]\\s*(?:it'?s|it is|but|this is|that'?s|rather)\\b"
