{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/nj-linkedin/steps.schema.json",
  "title": "Profile fix steps (profile/steps.json)",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "section": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "open": {
            "type": "string",
            "pattern": "^https://www\\.linkedin\\.com/"
          },
          "done": {
            "type": "boolean"
          }
        },
        "additionalProperties": true,
        "required": [
          "id",
          "title",
          "open"
        ]
      }
    }
  },
  "additionalProperties": true,
  "required": [
    "schema_version",
    "steps"
  ]
}
