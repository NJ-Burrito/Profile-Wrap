            "daily_cap": {
              "type": "integer",
              "minimum": 0,
              "x-ceiling": 10
            },
            "reply_reserve": {
              "type": "integer",
              "minimum": 0
            },
            "gap_seconds": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0
              },
              "minItems": 2,
              "maxItems": 2,
              "x-floor": 60
            },
            "like": {
              "type": "boolean"
            },
            "max_chars": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1250
            },
            "language": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "mode",
            "api_ack",
            "daily_cap",
            "reply_reserve",
            "gap_seconds",
            "like",
            "max_chars",
            "language"
          ]
        },
        "replies": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "draft",
                "api"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "mode"
          ]
        },
        "reading": {
          "type": "object",
          "properties": {
            "provider": {
              "enum": [
                "manual",
                "export",
                "apify"
              ]
            },
            "apify_ack": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/definitions/ack"
